# Janaya Computer Shop — environment
# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# Web server
PORT=4000
NODE_ENV=development

# MySQL connection.
# Local XAMPP defaults: user root, empty password, port 3306.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=janaya_shop

# Session signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to true only when serving over HTTPS (secure cookies). Leave false on plain http.
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy / PaaS (Render, Railway, nginx).
TRUST_PROXY=false
